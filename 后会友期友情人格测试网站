// 平局时的优先顺序（越靠前越优先）
const PRIORITY = ["zm","mty","qz","xf","wzx","bxc","ln","wje"];
const LETTERS = "ABCDE";
// 每个角色在随机作答下的期望得分（用于归一化）
const EXPECT = {};
Object.keys(ROLES).forEach(k=>EXPECT[k]=0);
QUESTIONS.forEach(q=>q.o.forEach(o=>{for(const k in o.s) EXPECT[k]+=o.s[k]/q.o.length;}));

/* ========== 状态 ========== */
let cur = 0, answers = [];
const $ = id => document.getElementById(id);
function show(id){document.querySelectorAll(".screen").forEach(s=>s.classList.remove("active"));$(id).classList.add("active");window.scrollTo(0,0);}

function renderQ(){
  const item = QUESTIONS[cur];
  $("count").textContent = (cur+1)+"/"+QUESTIONS.length;
  $("barFill").style.width = (cur/QUESTIONS.length*100)+"%";
  $("qscene").textContent = item.scene;
  $("qtitle").textContent = item.q;
  $("backBtn").disabled = cur===0;
  const box = $("opts"); box.innerHTML="";
  item.o.forEach((op,i)=>{
    const b=document.createElement("button");
    b.className="opt"+(answers[cur]===i?" picked":"");
    b.innerHTML=`<b>${LETTERS[i]}</b><span>${op.t}</span>`;
    b.onclick=()=>pick(i,b);
    box.appendChild(b);
  });
}
let locking=false;
function pick(i,el){
  if(locking) return; locking=true;
  answers[cur]=i;
  document.querySelectorAll(".opt").forEach(x=>x.classList.remove("picked"));
  el.classList.add("picked");
  setTimeout(()=>{
    locking=false;
    if(cur<QUESTIONS.length-1){cur++;renderQ();}
    else finish();
  },260);
}

/* ========== 计分 ========== */
function compute(){
  const raw={}; Object.keys(ROLES).forEach(k=>raw[k]=0);
  let nonePicks=0;
  answers.forEach((ai,qi)=>{
    const s=QUESTIONS[qi].o[ai].s;
    for(const k in s){raw[k]+=s[k]; if(k==="none") nonePicks++;}
  });
  // 按各角色的“期望得分”归一化，保证题目分值分布不均时各角色出现概率公平，再乘以权重
  const scored = PRIORITY.map(k=>({k,v:raw[k]/EXPECT[k]*ROLES[k].weight}))
    .sort((a,b)=> b.v-a.v || PRIORITY.indexOf(a.k)-PRIORITY.indexOf(b.k));
  // 隐藏款触发：选了≥3个“离谱选项”，或选了2个且其他角色都不突出
  let key = scored[0].k;
  if(nonePicks>=3 || (nonePicks===2 && scored[0].v<1.4)) key="none";
  return {key, scored};
}

const CALC_TEXTS=["观察室正在激烈讨论你…","张泉灵老师正在追问细节…","李维嘉翻出了一张题卡…","心理学教授正在拆解你的友情…"];
function finish(){
  $("barFill").style.width="100%";
  show("calc");
  let t=0; const it=setInterval(()=>{t++;$("calcText").textContent=CALC_TEXTS[t%CALC_TEXTS.length];},550);
  setTimeout(()=>{clearInterval(it);renderResult(compute());},1800);
}

let lastResult=null;
function renderResult({key,scored}){
  const r=ROLES[key]; lastResult={key,scored};
  $("hero").style.background=`linear-gradient(135deg,${r.color[0]},${r.color[1]})`;
  $("hero").innerHTML=`<div class="small">你在友情里是</div>
    <div class="emoji">${r.emoji}</div>
    <div class="role">${r.name}</div>
    <div class="title">${r.title}</div>
    <div class="quote">“${r.quote}”</div>
    <div class="kw">${r.keywords.map(k=>`<span>#${k}</span>`).join("")}</div>`;
  $("rBase").textContent=r.base;
  $("rBehave").innerHTML=r.behave.map(b=>`<li>${b}</li>`).join("");
  $("rPower").textContent=r.power;
  $("rTip").textContent=r.tip;
  $("rPair").innerHTML=`<div class="good">最合拍<strong>${r.good[0]}</strong>${r.good[1]}</div>
    <div class="tune">需要磨合<strong>${r.tune[0]}</strong>${r.tune[1]}</div>`;
  // 成分条：展示前 4 名
  const top=scored.slice(0,4), max=top[0].v||1;
  let rows = top.map((x,i)=>({name:ROLES[x.k].name, pct: Math.round(i===0&&key!=="none"?88+Math.min(10,(x.v-top[1].v)*25):40+46*x.v/max), color:ROLES[x.k].color[0]}));
  if(key==="none") rows = [{name:"隐藏款",pct:99,color:ROLES.none.color[0]}].concat(rows.slice(0,3).map(x=>({...x,pct:Math.min(x.pct,30)})));
  rows.sort((a,b)=>b.pct-a.pct);
  $("rMatch").innerHTML=rows.map(x=>`<div class="match-row"><span class="n">${x.name}</span><span class="mb"><i style="background:${x.color}" data-w="${x.pct}"></i></span><span class="v">${x.pct}%</span></div>`).join("");
  show("result");
  setTimeout(()=>document.querySelectorAll(".mb i").forEach(i=>i.style.width=i.dataset.w+"%"),80);
}

