  ctx.fillStyle="#fbf6ef";ctx.fillRect(0,0,W,H);
  // 卡片
  const g=ctx.createLinearGradient(0,0,W,620);g.addColorStop(0,r.color[0]);g.addColorStop(1,r.color[1]);
  ctx.fillStyle=g;ctx.beginPath();ctx.roundRect?ctx.roundRect(40,40,W-80,620,40):ctx.rect(40,40,W-80,620);ctx.fill();
  ctx.fillStyle="rgba(255,255,255,.14)";ctx.beginPath();ctx.arc(W-90,90,140,0,Math.PI*2);ctx.fill();
  ctx.fillStyle="#fff";
  ctx.font=font(28);ctx.fillText("后会友期 · 我在友情里是",90,130);
  ctx.font=font(120);ctx.fillText(r.emoji,90,290);
  ctx.font=font(34);ctx.fillText(r.name,90,360);
  ctx.font=font(56,"bold");wrapText(ctx,r.title,90,435,W-180,70);
  ctx.font=font(28);wrapText(ctx,"“"+r.quote+"”",90,540,W-180,42);
  ctx.font=font(26);ctx.fillText(r.keywords.map(k=>"#"+k).join("  "),90,625);
  // 正文
  ctx.fillStyle="#2b2a33";ctx.font=font(32,"bold");ctx.fillText("✨ 我的友情超能力",60,730);
  ctx.fillStyle="#46434f";ctx.font=font(28);let y=wrapText(ctx,r.power,60,780,W-120,44);
  ctx.fillStyle="#2b2a33";ctx.font=font(32,"bold");ctx.fillText("🤝 最合拍的朋友："+r.good[0],60,y+30);
  ctx.fillStyle="#46434f";ctx.font=font(28);wrapText(ctx,r.good[1],60,y+80,W-120,44);
  // 底部
  ctx.fillStyle="#e0604a";ctx.font=font(30,"bold");ctx.fillText("你是哪位嘉宾？扫码 / 搜索来测测 →",60,H-110);
  ctx.fillStyle="#a19ba9";ctx.font=font(22);ctx.fillText("非官方娱乐测试 · 结果仅供娱乐",60,H-60);
  $("modalImg").src=c.toDataURL("image/png");$("modal").classList.add("show");
};
$("modal").onclick=e=>{if(e.target.id==="modal")$("modal").classList.remove("show");};

