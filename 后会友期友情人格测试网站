};

function wrapText(ctx,text,x,y,maxW,lh){
  let line="",lines=0;
  for(const ch of text){
    if(ctx.measureText(line+ch).width>maxW){ctx.fillText(line,x,y);line=ch;y+=lh;lines++;}
    else line+=ch;
  }
  ctx.fillText(line,x,y); return y+lh;
}
$("saveBtn").onclick=()=>{
  const r=ROLES[lastResult.key];
  const W=750,H=1180,c=document.createElement("canvas");c.width=W;c.height=H;
